
/*
  ARDUINO ROBOT ARMY - RECEIVER

  Hardware:
  Arduino Nano
  NRF24L01
  L298N Motor Driver
  2 DC Motors

  All four robots use this same code.
*/

#include <SPI.h>
#include <nRF24L01.h>
#include <RF24.h>

RF24 radio(9, 10);

const byte address[6] = "BOT01";

// Must match transmitter packet exactly
struct ControlPacket {
  char command;
  byte speed;
  uint16_t sequence;
};

ControlPacket data;

// L298N pins
#define ENA 5
#define IN1 2
#define IN2 3

#define IN3 4
#define IN4 7
#define ENB 6

// Communication failsafe
unsigned long lastReceived = 0;
const unsigned long FAILSAFE_TIME = 300;

// Stop motors
void stopBot() {

  analogWrite(ENA, 0);
  analogWrite(ENB, 0);

  digitalWrite(IN1, LOW);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, LOW);
}

// Forward
void moveForward(byte speed) {

  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);

  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);

  analogWrite(ENA, speed);
  analogWrite(ENB, speed);
}

// Backward
void moveBackward(byte speed) {

  digitalWrite(IN1, LOW);
  digitalWrite(IN2, HIGH);

  digitalWrite(IN3, LOW);
  digitalWrite(IN4, HIGH);

  analogWrite(ENA, speed);
  analogWrite(ENB, speed);
}

// Left
void turnLeft(byte speed) {

  digitalWrite(IN1, LOW);
  digitalWrite(IN2, HIGH);

  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);

  analogWrite(ENA, speed);
  analogWrite(ENB, speed);
}

// Right
void turnRight(byte speed) {

  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);

  digitalWrite(IN3, LOW);
  digitalWrite(IN4, HIGH);

  analogWrite(ENA, speed);
  analogWrite(ENB, speed);
}

void setup() {

  Serial.begin(9600);

  // Motor driver pin setup
  pinMode(ENA, OUTPUT);
  pinMode(ENB, OUTPUT);

  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);

  stopBot();

  // Initialize NRF24
  if (!radio.begin()) {

    Serial.println("NRF24 not detected!");

    while (1) {
      stopBot();
    }
  }

  radio.setChannel(100);
  radio.setDataRate(RF24_250KBPS);
  radio.setPALevel(RF24_PA_LOW);

  radio.setAutoAck(false);
  radio.disableDynamicPayloads();

  radio.setPayloadSize(sizeof(ControlPacket));

  // All robots listen to the same address
  radio.openReadingPipe(1, address);

  radio.startListening();

  Serial.println("Robot receiver ready!");
}

void loop() {

  // Check for incoming broadcast packets
  if (radio.available()) {

    while (radio.available()) {

      radio.read(&data, sizeof(data));

      lastReceived = millis();

      switch (data.command) {

        case 'F':
          moveForward(data.speed);
          break;

        case 'B':
          moveBackward(data.speed);
          break;

        case 'L':
          turnLeft(data.speed);
          break;

        case 'R':
          turnRight(data.speed);
          break;

        case 'S':
        default:
          stopBot();
          break;
      }

      Serial.print("Command: ");
      Serial.println(data.command);
    }
  }

  // Stop when transmitter signal is lost
  if (millis() - lastReceived > FAILSAFE_TIME) {
    stopBot();
  }
}
